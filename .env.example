# Chave do Google Gemini (https://aistudio.google.com/apikey). Sem chave, o agent usa o runner determinístico.
GEMINI_API_KEY=
# Modelo usado pelo agent (padrão: gemini-3.5-flash-lite — rápido e barato)
GEMINI_MODEL=gemini-3.5-flash-lite
# Runner do agent: "auto" (Gemini se houver chave, senão determinístico), "gemini" ou "scripted"
AGENT_RUNNER=auto

# Segredo para assinar o cookie de sessão (troque em produção)
SESSION_SECRET=troque-este-segredo-local

# Serviço de chamados (legado simulado)
TICKETS_SERVICE_URL=http://localhost:4001
TICKETS_SERVICE_PORT=4001
TICKETS_SERVICE_TOKEN=dev-service-token
# Probabilidade (0 a 1) de uma requisição derrubar o serviço por alguns segundos
TICKETS_OUTAGE_RATE=0.1
# Duração da indisponibilidade simulada, em ms
TICKETS_OUTAGE_MS=2500

# Bancos SQLite (opcional; padrão em ./data)
# WEB_DB_PATH=./data/web.db
# TICKETS_DB_PATH=./data/tickets.db
